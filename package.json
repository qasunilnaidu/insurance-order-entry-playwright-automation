{
  "name": "insurance-order-entry-playwright-automation",
  "version": "2.0.0",
  "description": "Playwright (TypeScript) UI + API automation framework for the Insurance Order Entry Platform - Submission 2 (driven by the Test Case Design Sheet)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:wave1": "playwright test --grep @wave1",
    "test:wave2": "playwright test --grep @wave2",
    "test:wave3": "playwright test --grep @wave3",
    "test:short": "playwright test --grep @short",
    "test:critical": "playwright test --grep @critical",
    "test:auth": "playwright test --grep @auth",
    "test:dashboard": "playwright test --grep @dashboard",
    "test:client": "playwright test --grep @client",
    "test:address": "playwright test --grep @address",
    "test:kyc": "playwright test --grep @kyc",
    "test:product": "playwright test --grep @product",
    "test:rider": "playwright test --grep @rider",
    "test:beneficiary": "playwright test --grep @beneficiary",
    "test:documents": "playwright test --grep @documents",
    "test:workflow": "playwright test --grep @workflow",
    "test:xbrowser": "playwright test --project=firefox --project=webkit",
    "test:lockout": "playwright test tests/auth/lockout.spec.ts --workers=1",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "check:traceability": "node scripts/check-traceability.js",
    "report": "playwright show-report reports/html",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
