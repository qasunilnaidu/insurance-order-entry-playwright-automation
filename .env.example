# Copy this file to ".env" and fill in the values for your lab environment.
# Variable names follow the "Test Data" sheet of the Test Case Design workbook.
# Credentials are distributed offline by the program - never commit the real .env.

# ---- Environment -------------------------------------------------------------
# Insurance order entry app (Open Item #1: confirm port 8081 vs 8082 - the FinServe app also runs in the lab)
BASE_URL=http://127.0.0.1:8081
APP_NAME=insurance
# API origin (leave empty to use BASE_URL). A trailing /api is accepted and ignored:
# test paths already start with /api/...
API_BASE_URL=

# ---- Seeded agents (Open Item #2) -------------------------------------------
VALID_AGENT_USER=
VALID_AGENT_PASS=
SECOND_AGENT_USER=
SECOND_AGENT_PASS=
NEW_AGENT_USER=
NEW_AGENT_PASS=
LOCKED_AGENT_USER=
LOCKED_AGENT_PASS=
# RESERVED for the 5-failed-attempts test; needs an admin unlock after every run
LOCKOUT_TEST_AGENT_USER=
LOCKOUT_TEST_AGENT_PASS=
MFA_AGENT_USER=
MFA_AGENT_PASS=
MFA_OTP=
PENDING_AGENT_USER=
PENDING_AGENT_PASS=
# Disposable agent for password reset / change tests (TC-AUTH-08, 10, 11)
# Existing disposable agent for "wrong password" checks (TC-AUTH-02). Never the main agent: see fixtures/users.ts
WRONG_PASSWORD_PROBE_USER=learner028@insurance.test
RESET_AGENT_USER=
RESET_AGENT_PASS=
RESET_OTP=
# Leave RESET_OTP empty to read the freshly generated OTP from the app's Laravel log (demo behaviour)
APP_LOG_PATH=C:\qa-lab\apps\insurance-order-entry-demo\storage\logs\laravel.log

# Seeded application ids (resume / read-only checks)
SEEDED_DRAFT_ID=
SEEDED_SUBMITTED_ID=

# ---- Business rule values to CONFIRM in the running app (Open Items sheet) ----
PRODUCT_NAME=
# Comma separated product names expected in the catalog (TC-PROD-01)
EXPECTED_PRODUCTS=
INACTIVE_PRODUCT_NAME=
MIN_FACE_VALUE=25000
MAX_FACE_VALUE=1000000
# Product eligibility age range (TC-PROD-10); leave 0 to read it from the API if exposed
PRODUCT_MIN_AGE=0
PRODUCT_MAX_AGE=0
# Maximum KYC upload size in MB (TC-DOC-03)
MAX_UPLOAD_MB=5
MAX_RIDERS=3
RIDER_INELIGIBLE_AGE=64
LOW_ANNUAL_INCOME=100000
# block | allow | (empty = only record what the app does) - TC-ADDR-04
ZIP_STATE_MISMATCH_RULE=
# Name of the session cookie, if sessions are cookie based (TC-AUTH-04)
SESSION_COOKIE_NAME=

# Rider names exactly as displayed in the UI
RIDER_ADB=Accidental Death Benefit
RIDER_CRITICAL_ILLNESS=Critical Illness
RIDER_WAIVER_1=Waiver of Premium
RIDER_WAIVER_2=Waiver of Premium - Disability
# Rider dependency pair (TC-RID-08)
RIDER_DEPENDENT=
RIDER_PREREQUISITE=

# Optional: also run smoke tests on more browsers (TC-XC-01)
# BROWSERS=chromium,firefox,webkit
BROWSERS=chromium
